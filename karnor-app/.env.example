# Public API origin, read when Vite builds the frontend.
# On Render: https://karnorbackend.onrender.com
# Leave empty to use same-origin requests through a hosting/Vite proxy.
VITE_API_BASE_URL=
# Spring backend used by Vite's development and preview proxy.
KARNOR_BACKEND_URL=http://127.0.0.1:8080
# Public seller details shown on the contact page and in purchase confirmations.
VITE_SELLER_LEGAL_NAME=
VITE_SELLER_ORG_NUMBER=
VITE_SELLER_EMAIL=
VITE_SELLER_PHONE=
VITE_SELLER_ADDRESS=
